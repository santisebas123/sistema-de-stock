
<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">
<style>
*,*::before,*::after{margin:0;padding:0;box-sizing:border-box}
:root{
  --sage:#4a6741;--sage-light:#6b8f62;--sage-dark:#2e4228;
  --mint:#e8f0e5;--mint-mid:#d1e3cb;--mint-deep:#b8d1b0;
  --cream:#f7f4ef;--paper:#faf8f5;
  --sand:#e8e2d8;--sand-dark:#c9c1b4;
  --text:#2a2a24;--text-mid:#5a5a52;--text-light:#8a8a80;
  --white:#ffffff;
  --gold:#b5974a;--gold-light:#d4b870;
  --red-soft:#c0605a;--red-bg:#f5ecea;
  --green-soft:#4a7a55;--green-bg:#e8f2eb;
  --amber-soft:#b07830;--amber-bg:#f5eedf;
  --r:10px;--r-lg:16px;
  --shadow:0 1px 4px rgba(42,42,36,0.08);
  --shadow-md:0 4px 16px rgba(42,42,36,0.10);
}
body{font-family:'DM Sans',sans-serif;background:var(--cream);color:var(--text);font-size:14px;min-height:100vh;display:flex;flex-direction:column}

/* LAYOUT */
.app{display:flex;min-height:100vh}
.sidebar{width:220px;background:var(--sage-dark);display:flex;flex-direction:column;position:fixed;top:0;left:0;height:100vh;z-index:50}
.main{margin-left:220px;flex:1;display:flex;flex-direction:column;min-height:100vh}
.topbar{background:var(--paper);border-bottom:1px solid var(--sand);padding:0 28px;height:56px;display:flex;align-items:center;justify-content:space-between;position:sticky;top:0;z-index:40}
.content{padding:28px;flex:1;background:var(--cream)}

/* SIDEBAR */
.sb-logo{padding:24px 20px 16px;border-bottom:1px solid rgba(255,255,255,0.08)}
.sb-logo-name{font-family:'DM Serif Display',serif;font-size:1.3rem;color:#fff;letter-spacing:0.02em}
.sb-logo-sub{font-size:11px;color:rgba(255,255,255,0.45);letter-spacing:0.1em;text-transform:uppercase;margin-top:2px}
.sb-section{padding:16px 12px 4px;font-size:10px;letter-spacing:0.15em;text-transform:uppercase;color:rgba(255,255,255,0.35)}
.sb-item{display:flex;align-items:center;gap:10px;padding:9px 14px;border-radius:8px;margin:2px 8px;cursor:pointer;color:rgba(255,255,255,0.65);font-size:13px;transition:all 0.15s;border:none;background:none;width:calc(100% - 16px);text-align:left}
.sb-item:hover{background:rgba(255,255,255,0.08);color:#fff}
.sb-item.active{background:rgba(255,255,255,0.15);color:#fff}
.sb-item svg{width:16px;height:16px;opacity:0.8;flex-shrink:0}
.sb-item.active svg{opacity:1}
.sb-bottom{margin-top:auto;padding:16px;border-top:1px solid rgba(255,255,255,0.08)}
.sb-currency{display:flex;align-items:center;gap:8px;padding:8px 10px;background:rgba(255,255,255,0.07);border-radius:8px;font-size:12px;color:rgba(255,255,255,0.6)}
.currency-badge{background:var(--gold);color:#fff;font-size:10px;font-weight:500;padding:2px 6px;border-radius:4px}

/* TOPBAR */
.page-title{font-family:'DM Serif Display',serif;font-size:1.25rem;color:var(--text)}
.topbar-right{display:flex;align-items:center;gap:12px}
.badge-notif{background:var(--mint);color:var(--sage-dark);font-size:11px;padding:4px 10px;border-radius:20px;font-weight:500}

/* CARDS */
.card{background:var(--paper);border:1px solid var(--sand);border-radius:var(--r-lg);padding:20px}
.card-sm{background:var(--paper);border:1px solid var(--sand);border-radius:var(--r);padding:16px}

/* STAT CARDS */
.stats-row{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-bottom:24px}
.stat-card{background:var(--paper);border:1px solid var(--sand);border-radius:var(--r-lg);padding:18px 20px}
.stat-label{font-size:11px;letter-spacing:0.08em;text-transform:uppercase;color:var(--text-light);margin-bottom:8px}
.stat-value{font-family:'DM Serif Display',serif;font-size:1.8rem;color:var(--text);line-height:1}
.stat-sub{font-size:11px;color:var(--text-light);margin-top:6px}
.stat-up{color:var(--green-soft)}
.stat-down{color:var(--red-soft)}
.stat-accent{border-left:3px solid var(--sage-light)}

/* SECTION TITLES */
.sec-title{font-family:'DM Serif Display',serif;font-size:1.1rem;color:var(--text);margin-bottom:14px}
.sec-row{display:flex;align-items:center;justify-content:space-between;margin-bottom:14px}
.grid-2{display:grid;grid-template-columns:1fr 1fr;gap:20px}
.grid-3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:16px}

/* BUTTONS */
.btn{display:inline-flex;align-items:center;gap:6px;padding:8px 16px;border-radius:8px;font-size:13px;font-weight:500;cursor:pointer;border:none;transition:all 0.15s;font-family:'DM Sans',sans-serif}
.btn-primary{background:var(--sage);color:#fff}
.btn-primary:hover{background:var(--sage-light)}
.btn-ghost{background:transparent;color:var(--text-mid);border:1px solid var(--sand-dark)}
.btn-ghost:hover{background:var(--mint)}
.btn-sm{padding:5px 12px;font-size:12px}
.btn-danger{background:var(--red-bg);color:var(--red-soft);border:1px solid #e8c8c5}

/* TABLES */
.table-wrap{overflow-x:auto}
table{width:100%;border-collapse:collapse}
th{font-size:11px;letter-spacing:0.08em;text-transform:uppercase;color:var(--text-light);padding:8px 12px;text-align:left;border-bottom:1px solid var(--sand)}
td{padding:11px 12px;border-bottom:1px solid var(--mint);font-size:13px;color:var(--text)}
tr:last-child td{border-bottom:none}
tr:hover td{background:var(--mint)}
.td-name{font-weight:500;color:var(--text)}
.td-muted{color:var(--text-light)}

/* BADGES */
.badge{display:inline-flex;align-items:center;padding:3px 9px;border-radius:20px;font-size:11px;font-weight:500}
.badge-green{background:var(--green-bg);color:var(--green-soft)}
.badge-red{background:var(--red-bg);color:var(--red-soft)}
.badge-amber{background:var(--amber-bg);color:var(--amber-soft)}
.badge-sage{background:var(--mint-mid);color:var(--sage-dark)}

/* FORMS */
.form-group{margin-bottom:14px}
.form-label{display:block;font-size:12px;color:var(--text-mid);margin-bottom:5px;font-weight:500}
.form-input{width:100%;padding:8px 12px;border:1px solid var(--sand-dark);border-radius:8px;font-size:13px;font-family:'DM Sans',sans-serif;background:var(--paper);color:var(--text);transition:border 0.15s}
.form-input:focus{outline:none;border-color:var(--sage-light);box-shadow:0 0 0 3px rgba(107,143,98,0.12)}
.form-select{appearance:none;background-image:url("data:image/svg+xml,%3Csvg width='10' height='6' viewBox='0 0 10 6' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M1 1L5 5L9 1' stroke='%238a8a80' stroke-width='1.5' stroke-linecap='round'/%3E%3C/svg%3E");background-repeat:no-repeat;background-position:right 12px center}
.form-row{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.form-row-3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:12px}

/* VARIANTES */
.variant-tag{display:inline-flex;align-items:center;gap:5px;padding:4px 10px;background:var(--mint);border:1px solid var(--mint-deep);border-radius:20px;font-size:12px;color:var(--sage-dark);margin:3px}
.variant-tag .remove{cursor:pointer;opacity:0.5;font-size:14px;line-height:1}
.variant-tag .remove:hover{opacity:1}

/* PRODUCTO CARD */
.product-row{display:flex;align-items:center;justify-content:space-between;padding:12px 0;border-bottom:1px solid var(--mint)}
.product-row:last-child{border-bottom:none}
.product-info{display:flex;align-items:center;gap:12px}
.product-icon{width:36px;height:36px;background:var(--mint-mid);border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:16px;flex-shrink:0}
.product-name{font-weight:500;font-size:13px;color:var(--text)}
.product-cat{font-size:11px;color:var(--text-light)}
.product-stock{font-family:'DM Serif Display',serif;font-size:1.3rem;color:var(--sage)}
.product-stock-label{font-size:10px;color:var(--text-light);text-align:right}
.stock-low{color:var(--red-soft)}

/* MODAL */
.modal-overlay{position:fixed;inset:0;background:rgba(42,42,36,0.4);z-index:200;display:flex;align-items:center;justify-content:center;backdrop-filter:blur(2px)}
.modal{background:var(--paper);border-radius:var(--r-lg);width:520px;max-width:95vw;max-height:90vh;overflow-y:auto;box-shadow:var(--shadow-md);padding:28px}
.modal-header{display:flex;align-items:center;justify-content:space-between;margin-bottom:20px}
.modal-title{font-family:'DM Serif Display',serif;font-size:1.2rem;color:var(--text)}
.modal-close{background:none;border:none;cursor:pointer;color:var(--text-light);font-size:20px;line-height:1;padding:4px}
.modal-close:hover{color:var(--text)}
.modal-footer{display:flex;gap:10px;justify-content:flex-end;margin-top:20px;padding-top:16px;border-top:1px solid var(--sand)}
.hidden{display:none}

/* MINI CHART */
.bar-chart{display:flex;align-items:flex-end;gap:6px;height:80px;padding:8px 0}
.bar{flex:1;background:var(--mint-mid);border-radius:4px 4px 0 0;transition:background 0.2s;cursor:pointer;position:relative}
.bar:hover{background:var(--sage-light)}
.bar-label{font-size:10px;color:var(--text-light);text-align:center;margin-top:4px}

/* PRESUPUESTO STATUS */
.pres-status{display:flex;align-items:center;gap:6px;font-size:12px}
.dot{width:6px;height:6px;border-radius:50%;flex-shrink:0}
.dot-green{background:var(--green-soft)}
.dot-red{background:var(--red-soft)}
.dot-amber{background:var(--amber-soft)}

/* CAJA */
.caja-row{display:flex;justify-content:space-between;align-items:center;padding:10px 0;border-bottom:1px solid var(--mint)}
.caja-row:last-child{border-bottom:none}
.caja-total{background:var(--sage-dark);border-radius:var(--r);padding:16px 20px;display:flex;justify-content:space-between;align-items:center;margin-top:16px}
.caja-total-label{font-size:12px;color:rgba(255,255,255,0.6)}
.caja-total-value{font-family:'DM Serif Display',serif;font-size:1.5rem;color:#fff}

/* VALORACION */
.valor-item{display:flex;justify-content:space-between;padding:8px 0;border-bottom:1px solid var(--mint)}
.valor-item:last-child{border-bottom:none}

/* WEB PREVIEW */
.web-preview{background:#f0f4ee;border-radius:var(--r-lg);overflow:hidden;border:1px solid var(--mint-deep)}
.web-header{background:var(--sage-dark);padding:12px 20px;display:flex;align-items:center;justify-content:space-between}
.web-header-logo{font-family:'DM Serif Display',serif;color:#fff;font-size:1rem}
.web-product-list{padding:16px 20px}
.web-product-item{display:flex;justify-content:space-between;align-items:center;padding:10px 12px;background:#fff;border-radius:8px;margin-bottom:6px;border:1px solid var(--mint-deep)}
.web-product-name{font-size:13px;font-weight:500;color:var(--text)}
.web-product-qty{font-family:'DM Serif Display',serif;font-size:1.1rem;color:var(--sage);margin-right:4px}
.web-product-qty-label{font-size:11px;color:var(--text-light)}

/* PAGES */
.page{display:none}
.page.active{display:block}

/* TABS */
.tabs{display:flex;gap:4px;background:var(--mint);padding:4px;border-radius:10px;margin-bottom:20px}
.tab{flex:1;padding:7px 10px;border-radius:7px;font-size:12px;font-weight:500;cursor:pointer;border:none;background:none;color:var(--text-mid);text-align:center;transition:all 0.15s}
.tab.active{background:var(--paper);color:var(--sage-dark);box-shadow:var(--shadow)}

/* DIVIDER */
.divider{height:1px;background:var(--sand);margin:20px 0}

/* SCROLLBAR */
::-webkit-scrollbar{width:5px;height:5px}
::-webkit-scrollbar-track{background:transparent}
::-webkit-scrollbar-thumb{background:var(--mint-deep);border-radius:10px}
</style>
</head>
<body>

<div class="app">

<!-- SIDEBAR -->
<aside class="sidebar">
  <div class="sb-logo">
    <div class="sb-logo-name">Gestión</div>
    <div class="sb-logo-sub">Sistema de gestión</div>
  </div>

  <div class="sb-section">Principal</div>
  <button class="sb-item active" onclick="goTo('dashboard',this)">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
    Dashboard
  </button>

  <div class="sb-section">Stock</div>
  <button class="sb-item" onclick="goTo('stock',this)">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 7H4a2 2 0 00-2 2v10a2 2 0 002 2h16a2 2 0 002-2V9a2 2 0 00-2-2z"/><path d="M16 7V5a2 2 0 00-2-2h-4a2 2 0 00-2 2v2"/></svg>
    Productos
  </button>
  <button class="sb-item" onclick="goTo('valoracion',this)">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>
    Valoración
  </button>

  <div class="sb-section">Finanzas</div>
  <button class="sb-item" onclick="goTo('ventas',this)">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6"/></svg>
    Ventas
  </button>
  <button class="sb-item" onclick="goTo('presupuestos',this)">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="9" y1="13" x2="15" y2="13"/><line x1="9" y1="17" x2="13" y2="17"/></svg>
    Presupuestos
  </button>
  <button class="sb-item" onclick="goTo('caja',this)">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="7" width="20" height="15" rx="2"/><path d="M16 7V5a2 2 0 00-2-2h-4a2 2 0 00-2 2v2"/><line x1="12" y1="12" x2="12" y2="16"/><line x1="10" y1="14" x2="14" y2="14"/></svg>
    Caja
  </button>
  <button class="sb-item" onclick="goTo('gastos',this)">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
    Gastos
  </button>

  <div class="sb-section">Web</div>
  <button class="sb-item" onclick="goTo('webpublica',this)">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 014 10 15.3 15.3 0 01-4 10 15.3 15.3 0 01-4-10 15.3 15.3 0 014-10z"/></svg>
    Web pública
  </button>

  <div class="sb-bottom">
    <div class="sb-currency">
      <span class="currency-badge">ARS</span>
      <span class="currency-badge" style="background:var(--gold-light);color:var(--sage-dark)">USD</span>
      <span>Moneda dual</span>
    </div>
  </div>
</aside>

<!-- MAIN -->
<div class="main">

  <!-- TOPBAR -->
  <div class="topbar">
    <div class="page-title" id="page-title">Dashboard</div>
    <div class="topbar-right">
      <span class="badge-notif">2 alertas de stock</span>
      <button class="btn btn-primary btn-sm" id="topbar-btn" onclick="handleTopBtn()">+ Nuevo</button>
    </div>
  </div>

  <!-- CONTENT -->
  <div class="content">

    <!-- ════ DASHBOARD ════ -->
    <div id="page-dashboard" class="page active">
      <div class="stats-row">
        <div class="stat-card stat-accent">
          <div class="stat-label">Caja actual</div>
          <div class="stat-value">$842.500</div>
          <div class="stat-sub stat-up">↑ +12% esta semana</div>
        </div>
        <div class="stat-card stat-accent">
          <div class="stat-label">Ventas del mes</div>
          <div class="stat-value">$1.240.000</div>
          <div class="stat-sub stat-up">↑ 18 ventas aprobadas</div>
        </div>
        <div class="stat-card stat-accent">
          <div class="stat-label">Stock total</div>
          <div class="stat-value">347</div>
          <div class="stat-sub stat-down">↓ 2 productos bajos</div>
        </div>
        <div class="stat-card stat-accent">
          <div class="stat-label">Presupuestos</div>
          <div class="stat-value">6</div>
          <div class="stat-sub" style="color:var(--amber-soft)">4 pendientes</div>
        </div>
      </div>

      <div class="grid-2">
        <div class="card">
          <div class="sec-row">
            <div class="sec-title">Últimas ventas</div>
            <button class="btn btn-ghost btn-sm" onclick="goTo('ventas',null)">Ver todas →</button>
          </div>
          <div class="table-wrap">
            <table>
              <tr><th>Cliente</th><th>Producto</th><th>Total</th><th>Estado</th></tr>
              <tr><td class="td-name">María G.</td><td class="td-muted">Remera azul M</td><td>$28.000</td><td><span class="badge badge-green">Aprobada</span></td></tr>
              <tr><td class="td-name">Carlos R.</td><td class="td-muted">Pantalón negro L</td><td>$65.000</td><td><span class="badge badge-green">Aprobada</span></td></tr>
              <tr><td class="td-name">Laura M.</td><td class="td-muted">Zapatillas blancas</td><td>$120.000</td><td><span class="badge badge-amber">Pendiente</span></td></tr>
              <tr><td class="td-name">Pedro S.</td><td class="td-muted">Campera verde M</td><td>$95.000</td><td><span class="badge badge-red">Rechazada</span></td></tr>
            </table>
          </div>
        </div>

        <div class="card">
          <div class="sec-row">
            <div class="sec-title">Productos con stock bajo</div>
            <button class="btn btn-ghost btn-sm" onclick="goTo('stock',null)">Ver stock →</button>
          </div>
          <div id="products-low">
            <div class="product-row">
              <div class="product-info">
                <div class="product-icon">👕</div>
                <div><div class="product-name">Remera blanca S</div><div class="product-cat">Indumentaria</div></div>
              </div>
              <div><div class="product-stock stock-low">3</div><div class="product-stock-label">unidades</div></div>
            </div>
            <div class="product-row">
              <div class="product-info">
                <div class="product-icon">👟</div>
                <div><div class="product-name">Zapatillas 38</div><div class="product-cat">Calzado</div></div>
              </div>
              <div><div class="product-stock stock-low">2</div><div class="product-stock-label">unidades</div></div>
            </div>
            <div class="product-row">
              <div class="product-info">
                <div class="product-icon">🧢</div>
                <div><div class="product-name">Gorra negra</div><div class="product-cat">Accesorios</div></div>
              </div>
              <div><div class="product-stock" style="color:var(--sage)">15</div><div class="product-stock-label">unidades</div></div>
            </div>
          </div>
        </div>
      </div>

      <div style="margin-top:20px" class="card">
        <div class="sec-title">Ventas de la semana</div>
        <div class="bar-chart" id="dash-chart"></div>
        <div style="display:flex;gap:6px" id="dash-labels"></div>
      </div>
    </div>

    <!-- ════ STOCK ════ -->
    <div id="page-stock" class="page">
      <div class="sec-row">
        <div class="sec-title">Productos en stock</div>
        <button class="btn btn-primary" onclick="openModal('modal-producto')">+ Agregar producto</button>
      </div>

      <div class="card">
        <div style="display:flex;gap:10px;margin-bottom:16px">
          <input type="text" class="form-input" placeholder="Buscar producto..." style="max-width:280px" oninput="filterProducts(this.value)">
          <select class="form-input form-select" style="max-width:160px">
            <option>Todas las categorías</option>
            <option>Indumentaria</option><option>Calzado</option><option>Accesorios</option>
          </select>
        </div>
        <div class="table-wrap">
          <table>
            <tr><th>Producto</th><th>Categoría</th><th>Variantes</th><th>Stock</th><th>Costo unit.</th><th>Acciones</th></tr>
            <tbody id="stock-table-body">
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- ════ VALORACIÓN ════ -->
    <div id="page-valoracion" class="page">
      <div class="sec-title">Valoración del stock</div>
      <div class="grid-2" style="margin-bottom:20px">
        <div class="stat-card stat-accent">
          <div class="stat-label">Valor total a costo</div>
          <div class="stat-value" id="val-costo">$0</div>
          <div class="stat-sub">Precio de compra × stock</div>
        </div>
        <div class="stat-card stat-accent">
          <div class="stat-label">Valor potencial de venta</div>
          <div class="stat-value" id="val-venta">$0</div>
          <div class="stat-sub">Precio de venta × stock</div>
