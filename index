<script>
// ─── STATE ───
const state = {
  productos: [
    {id:1,nombre:'Remera básica',cat:'Indumentaria',qty:45,costo:8000,ventaPrecio:18000,moneda:'ARS',emoji:'👕',variantes:[{key:'Color',val:'Blanco'},{key:'Talle',val:'M'}]},
    {id:2,nombre:'Pantalón cargo',cat:'Indumentaria',qty:12,costo:22000,ventaPrecio:55000,moneda:'ARS',emoji:'👖',variantes:[{key:'Color',val:'Negro'},{key:'Talle',val:'L'}]},
    {id:3,nombre:'Zapatillas runner',cat:'Calzado',qty:2,costo:35000,ventaPrecio:90000,moneda:'ARS',emoji:'👟',variantes:[{key:'Talle',val:'38'}]},
    {id:4,nombre:'Gorra negra',cat:'Accesorios',qty:15,costo:4500,ventaPrecio:12000,moneda:'ARS',emoji:'🧢',variantes:[]},
    {id:5,nombre:'Remera blanca S',cat:'Indumentaria',qty:3,costo:8000,ventaPrecio:18000,moneda:'ARS',emoji:'👕',variantes:[{key:'Talle',val:'S'}]},
  ],
  ventas: [
    {id:1,fecha:'2025-05-08',cliente:'María G.',producto:'Remera básica',qty:2,total:36000,moneda:'ARS',estado:'Aprobada'},
    {id:2,fecha:'2025-05-07',cliente:'Carlos R.',producto:'Pantalón cargo',qty:1,total:55000,moneda:'ARS',estado:'Aprobada'},
    {id:3,fecha:'2025-05-06',cliente:'Laura M.',producto:'Zapatillas runner',qty:1,total:90000,moneda:'ARS',estado:'Pendiente'},
    {id:4,fecha:'2025-05-05',cliente:'Pedro S.',producto:'Gorra negra',qty:3,total:36000,moneda:'ARS',estado:'Rechazada'},
  ],
  presupuestos: [
    {id:1,cliente:'Ana F.',desc:'Uniformes equipo',total:280000,moneda:'ARS',fecha:'2025-05-20',estado:'pendiente'},
    {id:2,cliente:'Tech SA',desc:'Remeras corporativas x20',total:420000,moneda:'ARS',fecha:'2025-05-15',estado:'aprobado'},
    {id:3,cliente:'Lucas B.',desc:'Ropa deportiva',total:185000,moneda:'ARS',fecha:'2025-05-10',estado:'rechazado'},
  ],
  caja: [
    {desc:'Apertura de caja',tipo:'Ingreso',monto:500000,moneda:'ARS'},
    {desc:'Ventas del día',tipo:'Ingreso',monto:450000,moneda:'ARS'},
    {desc:'Pago proveedor',tipo:'Egreso',monto:120000,moneda:'ARS'},
    {desc:'Alquiler',tipo:'Egreso',monto:180000,moneda:'ARS'},
  ],
  gastos: [
    {cat:'Proveedores',desc:'Stock inicial',monto:450000,moneda:'ARS'},
    {cat:'Alquiler',desc:'Mes de mayo',monto:180000,moneda:'ARS'},
    {cat:'Servicios',desc:'Internet + luz',monto:35000,moneda:'ARS'},
    {cat:'Marketing',desc:'Instagram Ads',monto:25000,moneda:'ARS'},
  ],
  variants_temp: [],
  nextId: 10,
  presFilter: 'todos',
};

// ─── NAVIGATION ───
function goTo(page, btn) {
  document.querySelectorAll('.page').forEach(p=>p.classList.remove('active'));
  document.getElementById('page-'+page).classList.add('active');
  document.querySelectorAll('.sb-item').forEach(b=>b.classList.remove('active'));
  if(btn) btn.classList.add('active');
  const titles = {dashboard:'Dashboard',stock:'Productos',valoracion:'Valoración de stock',ventas:'Ventas',presupuestos:'Presupuestos',caja:'Estado de caja',gastos:'Gastos',webpublica:'Web pública'};
  document.getElementById('page-title').textContent = titles[page]||page;
  if(page==='stock') renderStock();
  if(page==='valoracion') renderValoracion();
  if(page==='ventas') renderVentas();
  if(page==='presupuestos') renderPresupuestos();
  if(page==='caja') renderCaja();
  if(page==='gastos') renderGastos();
  if(page==='webpublica') renderWeb();
  if(page==='dashboard') renderDashChart();
}

function handleTopBtn() {
  const p = document.querySelector('.page.active').id.replace('page-','');
  if(p==='stock') openModal('modal-producto');
  else if(p==='ventas') openModal('modal-venta');
  else if(p==='presupuestos') openModal('modal-presupuesto');
}

// ─── MODALS ───
function openModal(id) {
  if(id==='modal-venta') populateVentaSelect();
  document.getElementById(id).classList.remove('hidden');
}
function closeModal(id) { document.getElementById(id).classList.add('hidden'); }

// ─── FORMAT ───
function fmt(n) { return '$'+parseInt(n).toLocaleString('es-AR'); }
function fmtMoneda(n,m) { return m==='USD'?'USD '+parseInt(n).toLocaleString():'$'+parseInt(n).toLocaleString('es-AR'); }

// ─── STOCK ───
function renderStock(filter='') {
  const body = document.getElementById('stock-table-body');
  const data = filter ? state.productos.filter(p=>p.nombre.toLowerCase().includes(filter.toLowerCase())) : state.productos;
  body.innerHTML = data.map(p=>`
    <tr>
      <td><div style="display:flex;align-items:center;gap:8px"><span>${p.emoji||'📦'}</span><span class="td-name">${p.nombre}</span></div></td>
      <td class="td-muted">${p.cat||'—'}</td>
      <td>${p.variantes.map(v=>`<span class="variant-tag" style="margin:2px">${v.key}: ${v.val}</span>`).join('')||'<span class="td-muted">—</span>'}</td>
      <td><span style="font-family:'DM Serif Display',serif;font-size:1.1rem;color:${p.qty<=5?'var(--red-soft)':'var(--sage)'}">${p.qty}</span></td>
      <td class="td-muted">${fmtMoneda(p.costo,p.moneda)}</td>
      <td><button class="btn btn-sm btn-danger" onclick="deleteProduct(${p.id})">Eliminar</button></td>
    </tr>`).join('');
}

function filterProducts(v) { renderStock(v); }

function deleteProduct(id) {
  state.productos = state.productos.filter(p=>p.id!==id);
  renderStock();
}

// VARIANTS TEMP
function addVariant() {
  const k=document.getElementById('variant-key').value.trim();
  const v=document.getElementById('variant-val').value.trim();
  if(!k||!v) return;
  state.variants_temp.push({key:k,val:v});
  renderVariantTags();
  document.getElementById('variant-key').value='';
  document.getElementById('variant-val').value='';
}
function renderVariantTags() {
  document.getElementById('variants-container').innerHTML = state.variants_temp.map((v,i)=>
    `<span class="variant-tag">${v.key}: ${v.val} <span class="remove" onclick="removeVariant(${i})">×</span></span>`
  ).join('');
}
function removeVariant(i) { state.variants_temp.splice(i,1); renderVariantTags(); }

function saveProducto() {
  const nombre = document.getElementById('prod-nombre').value.trim();
  if(!nombre) { alert('El nombre es obligatorio'); return; }
  state.productos.push({
    id: state.nextId++,
    nombre,
    cat: document.getElementById('prod-cat').value,
    qty: parseInt(document.getElementById('prod-qty').value)||0,
    costo: parseInt(document.getElementById('prod-costo').value)||0,
    ventaPrecio: parseInt(document.getElementById('prod-venta-precio').value)||0,
    moneda: document.getElementById('prod-moneda').value,
    emoji: document.getElementById('prod-emoji').value||'📦',
    variantes: [...state.variants_temp],
  });
  state.variants_temp = [];
  renderVariantTags();
  ['prod-nombre','prod-cat','prod-qty','prod-costo','prod-venta-precio','prod-emoji'].forEach(id=>document.getElementById(id).value='');
  closeModal('modal-producto');
  renderStock();
}

// ─── VALORACIÓN ───
function renderValoracion() {
  let totalCosto=0, totalVenta=0;
  const body = document.getElementById('valoracion-body');
  body.innerHTML = state.productos.map(p=>{
    const vc=p.costo*p.qty, vv=p.ventaPrecio*p.qty;
    const margen = p.ventaPrecio>0 ? Math.round((p.ventaPrecio-p.costo)/p.ventaPrecio*100) : 0;
    totalCosto+=vc; totalVenta+=vv;
    return `<tr>
      <td class="td-name">${p.emoji} ${p.nombre}</td>
      <td>${p.qty}</td>
      <td class="td-muted">${fmtMoneda(p.costo,p.moneda)}</td>
      <td class="td-muted">${fmtMoneda(p.ventaPrecio,p.moneda)}</td>
      <td>${fmtMoneda(vc,p.moneda)}</td>
      <td style="color:var(--sage)">${fmtMoneda(vv,p.moneda)}</td>
      <td><span class="badge ${margen>40?'badge-green':margen>20?'badge-sage':'badge-amber'}">${margen}%</span></td>
    </tr>`;
  }).join('');
  document.getElementById('val-costo').textContent = fmt(totalCosto);
  document.getElementById('val-venta').textContent = fmt(totalVenta);
}

// ─── VENTAS ───
function populateVentaSelect() {
  document.getElementById('venta-producto').innerHTML = state.productos.map(p=>`<option value="${p.nombre}">${p.nombre}</option>`).join('');
}

function renderVentas() {
  document.getElementById('ventas-body').innerHTML = state.ventas.map(v=>`
    <tr>
      <td class="td-muted">${v.fecha}</td>
      <td class="td-name">${v.cliente}</td>
      <td>${v.producto}</td>
      <td>${v.qty}</td>
      <td>${fmtMoneda(v.total,v.moneda)}</td>
      <td><span class="badge badge-sage">${v.moneda}</span></td>
      <td><span class="badge ${v.estado==='Aprobada'?'badge-green':v.estado==='Rechazada'?'badge-red':'badge-amber'}">${v.estado}</span></td>
      <td>
        ${v.estado==='Pendiente'?`<button class="btn btn-sm" style="background:var(--green-bg);color:var(--green-soft);border:none;cursor:pointer;border-radius:6px;padding:4px 10px;font-size:11px" onclick="cambiarEstadoVenta(${v.id},'Aprobada')">✓ Aprobar</button>`:''}
      </td>
    </tr>`).join('');
}

function saveVenta() {
  const cliente = document.getElementById('venta-cliente').value.trim();
  const producto = document.getElementById('venta-producto').value;
  const qty = parseInt(document.getElementById('venta-qty').value)||1;
  const total = parseInt(document.getElementById('venta-total').value)||0;
  const moneda = document.getElementById('venta-moneda').value;
  const estado = document.getElementById('venta-estado').value;
  if(!cliente) return;
  const venta = {id:state.nextId++,fecha:new Date().toISOString().split('T')[0],cliente,producto,qty,total,moneda,estado};
  state.ventas.unshift(venta);
  if(estado==='Aprobada') bajarStock(producto, qty);
  closeModal('modal-venta');
  renderVentas();
}

function cambiarEstadoVenta(id, nuevoEstado) {
  const v = state.ventas.find(x=>x.id===id);
  if(v) { v.estado=nuevoEstado; if(nuevoEstado==='Aprobada') bajarStock(v.producto,v.qty); renderVentas(); }
}

function bajarStock(nombre, qty) {
  const p = state.productos.find(x=>x.nombre===nombre);
  if(p) { p.qty = Math.max(0, p.qty-qty); }
}

// ─── PRESUPUESTOS ───
function renderPresupuestos() {
  const data = state.presFilter==='todos' ? state.presupuestos : state.presupuestos.filter(p=>p.estado===state.presFilter);
  document.getElementById('pres-body').innerHTML = data.map(p=>`
    <tr>
      <td class="td-muted">#${p.id}</td>
      <td class="td-name">${p.cliente}</td>
      <td>${p.desc}</td>
      <td>${fmtMoneda(p.total,p.moneda)}</td>
      <td class="td-muted">${p.fecha}</td>
      <td><span class="badge ${p.estado==='aprobado'?'badge-green':p.estado==='rechazado'?'badge-red':'badge-amber'}">${p.estado.charAt(0).toUpperCase()+p.estado.slice(1)}</span></td>
      <td style="display:flex;gap:4px">
        ${p.estado==='pendiente'?`
          <button class="btn btn-sm" style="background:var(--green-bg);color:var(--green-soft);border:none;cursor:pointer;border-radius:6px;padding:4px 8px;font-size:11px" onclick="cambiarPres(${p.id},'aprobado')">✓</button>
          <button class="btn btn-sm" style="background:var(--red-bg);color:var(--red-soft);border:none;cursor:pointer;border-radius:6px;padding:4px 8px;font-size:11px" onclick="cambiarPres(${p.id},'rechazado')">✗</button>`
        :''}
      </td>
    </tr>`).join('');
}

function cambiarPres(id, estado) {
  const p = state.presupuestos.find(x=>x.id===id);
  if(p) {
    p.estado = estado;
    if(estado==='aprobado') {
      state.ventas.unshift({id:state.nextId++,fecha:new Date().toISOString().split('T')[0],cliente:p.cliente,producto:p.desc,qty:1,total:p.total,moneda:p.moneda,estado:'Aprobada'});
    }
    renderPresupuestos();
  }
}

function filterPres(f, btn) {
  state.presFilter = f;
  document.querySelectorAll('.tab').forEach(t=>t.classList.remove('active'));
  btn.classList.add('active');
  renderPresupuestos();
}

function savePresupuesto() {
  const cliente = document.getElementById('pres-cliente').value.trim();
  if(!cliente) return;
  state.presupuestos.unshift({
    id: state.nextId++,
    cliente,
    desc: document.getElementById('pres-desc').value,
    total: parseInt(document.getElementById('pres-total').value)||0,
    moneda: document.getElementById('pres-moneda').value,
    fecha: document.getElementById('pres-fecha').value || '—',
    estado: 'pendiente',
  });
  closeModal('modal-presupuesto');
  renderPresupuestos();
}

// ─── CAJA ───
function renderCaja() {
  let saldo = 0;
  document.getElementById('caja-movs').innerHTML = state.caja.map(m=>{
    if(m.tipo==='Ingreso') saldo+=m.monto; else saldo-=m.monto;
    return `<div class="caja-row">
      <div><div style="font-size:13px;font-weight:500">${m.desc}</div><div style="font-size:11px;color:var(--text-light)">${m.tipo} · ${m.moneda}</div></div>
      <div style="font-family:'DM Serif Display',serif;font-size:1.1rem;color:${m.tipo==='Ingreso'?'var(--green-soft)':'var(--red-soft)'}">${m.tipo==='Ingreso'?'+':'-'}${fmt(m.monto)}</div>
    </div>`;
  }).join('');
  document.getElementById('caja-saldo').textContent = fmt(saldo);
  document.getElementById('caja-usd').textContent = 'USD '+(saldo/1000).toFixed(0);
}

function addCajaMovimiento() {
  const desc = document.getElementById('caja-desc').value.trim();
  const monto = parseInt(document.getElementById('caja-monto').value)||0;
  if(!desc||!monto) return;
  state.caja.push({desc,tipo:document.getElementById('caja-tipo').value,monto,moneda:document.getElementById('caja-moneda').value});
  document.getElementById('caja-desc').value='';
  document.getElementById('caja-monto').value='';
  renderCaja();
}

// ─── GASTOS ───
function renderGastos() {
  const cats = {};
  state.gastos.forEach(g=>{ cats[g.cat]=(cats[g.cat]||0)+g.monto; });
  let total=0;
  document.getElementById('gastos-list').innerHTML = Object.entries(cats).map(([cat,monto])=>{
    total+=monto;
    return `<div class="caja-row">
      <div><div style="font-size:13px;font-weight:500">${cat}</div></div>
      <div style="color:var(--red-soft);font-family:'DM Serif Display',serif">${fmt(monto)}</div>
    </div>`;
  }).join('');
  document.getElementById('gastos-total').textContent = fmt(total);
}

function addGasto() {
  const desc = document.getElementById('gasto-desc').value.trim();
  const monto = parseInt(document.getElementById('gasto-monto').value)||0;
  if(!desc||!monto) return;
  state.gastos.push({cat:document.getElementById('gasto-cat').value,desc,monto,moneda:document.getElementById('gasto-moneda').value});
  document.getElementById('gasto-desc').value='';
  document.getElementById('gasto-monto').value='';
  renderGastos();
}

// ─── WEB PÚBLICA ───
function renderWeb() {
  const list = document.getElementById('web-product-list');
  list.innerHTML = state.productos.map(p=>`
    <div class="web-product-item">
      <div style="display:flex;align-items:center;gap:10px">
        <span style="font-size:18px">${p.emoji||'📦'}</span>
        <div>
          <div class="web-product-name">${p.nombre}</div>
          <div style="font-size:11px;color:var(--text-light)">${p.cat||''} ${p.variantes.length?'· '+p.variantes.map(v=>v.val).join(', '):''}</div>
        </div>
      </div>
      <div style="text-align:right">
        <span class="web-product-qty">${p.qty}</span>
        <span class="web-product-qty-label">en stock</span>
      </div>
    </div>`).join('');
}

// ─── DASHBOARD CHART ───
function renderDashChart() {
  const days = ['Lun','Mar','Mié','Jue','Vie','Sáb','Dom'];
  const vals = [45,80,35,90,65,120,75];
  const max = Math.max(...vals);
  const chart = document.getElementById('dash-chart');
  const labels = document.getElementById('dash-labels');
  chart.innerHTML = vals.map((v,i)=>`<div class="bar" style="height:${(v/max*100)}%" title="${days[i]}: $${v}k"></div>`).join('');
  labels.innerHTML = days.map(d=>`<div class="bar-label" style="flex:1">${d}</div>`).join('');
}

// ─── INIT ───
renderDashChart();
renderStock();
</script>
</body>
</html>
